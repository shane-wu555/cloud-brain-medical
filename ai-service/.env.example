AI_PROVIDER=openai_compatible
AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_OPENAI_API_KEY=replace-with-your-bailian-api-key
AI_OPENAI_MODEL=deepseek-v4-pro
AI_ALLOW_FALLBACK=true
AI_TIMEOUT_SECONDS=60

# Optional RAG settings. Keep these aligned with your local database.
AI_RAG_DATABASE_URL=postgresql://cloudbrain:cloudbrain@localhost:5432/cloud_brain_medical
AI_RAG_SCHEMA=ai
AI_RAG_EMBEDDING_DIM=64
