AI_PROVIDER=openai_compatible
AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_OPENAI_API_KEY=replace-with-your-bailian-api-key
AI_OPENAI_MODEL=deepseek-v4-pro
AI_ALLOW_FALLBACK=false
AI_TIMEOUT_SECONDS=60

# Optional RAG settings. Keep these aligned with your local database.
AI_RAG_DATABASE_URL=postgresql://cloudbrain:cloudbrain@localhost:5432/cloud_brain_medical
AI_RAG_SCHEMA=ai
AI_RAG_EMBEDDING_DIM=64

# CT 小模型配置（MinIO 地址与项目 docker-compose 保持一致）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_MODEL_BUCKET=models         # 训练完成后上传 .onnx 到此 bucket
MINIO_BUCKET=medical-imaging      # 病人 CT 影像所在 bucket，与 medical-order-service 保持一致

CT_MODEL_VERSION=ct-head-v1.0
CT_INFERENCE_ALLOW_MOCK=false
CT_INFERENCE_TIMEOUT_SECONDS=300
# Limit representative CT slices sent to the small models. Set 0 to run all valid slices.
CT_MAX_MODEL_SLICES=128
CT_INFERENCE_PARALLEL_WORKERS=4
CT_ONNX_INTER_OP_THREADS=1
CT_ONNX_INTRA_OP_THREADS=1
CT_CLASSIFIER_MODEL=F:\cloud-brain-medical\ai-service\models\classifier.onnx
CT_METAL_CLASSIFIER_MODEL=F:\cloud-brain-medical\ai-service\models\metal_severity\metal_classifier_severity.onnx
CT_METAL_SEGMENTATION_MODEL=F:\cloud-brain-medical\ai-service\models\metal_segmentation\metal_segmentation.onnx
# CT_DETECTOR_MODEL=F:\cloud-brain-medical\ai-service\models\detector.onnx
# If these local files are missing, the inference code falls back to repo
# defaults and then MinIO model objects under /tmp/ct_models.
